{
    "env": {
      "browser": true,
      "es2022": true
    },
    "parserOptions": {
      "sourceType": "module",
      "ecmaVersion": "latest"
    },
    "plugins": ["import"],
    "extends": ["eslint:recommended", "plugin:import/recommended"],
    "rules": {
      "import/extensions": [
        "error",
        "always",
        {
          "js": "always",
          "ts": "never"
        }
      ],
      "import/no-unresolved": "off"
    },
    "settings": {
      "import/resolver": {
        "node": {
          "extensions": [".js", ".ts"]
        }
      }
    }
  }
  